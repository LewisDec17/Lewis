DOMAIN-SUFFIX,wx2.qq.com
DOMAIN-SUFFIX,wx8.qq.com
DOMAIN-SUFFIX,qq.com
DOMAIN-SUFFIX,gtimg.cn
DOMAIN-SUFFIX,gtimg.com
DOMAIN-SUFFIX,tenpay.com
DOMAIN-SUFFIX,qqmail.com

# 2. 域名关键字匹配
DOMAIN-KEYWORD,weixin
DOMAIN-KEYWORD,wechat
DOMAIN-KEYWORD,wx.qq
DOMAIN-KEYWORD,qpic
DOMAIN-KEYWORD,qlogo
DOMAIN-KEYWORD,gtimg
DOMAIN-KEYWORD,tenpay

# 3. 进程匹配 (适用 iOS / macOS / Windows / Android 客户端分流)
PROCESS-NAME,WeChat
PROCESS-NAME,WeChat.exe
PROCESS-NAME,WeChatApp.exe
PROCESS-NAME,com.tencent.mm

